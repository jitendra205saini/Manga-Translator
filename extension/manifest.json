{
  "manifest_version": 3,
  "name": "Local Manga Translator (Hindi)",
  "version": "2.5",
  "description": "Translates manga and manhwa pages into casual Hindi using a local server (Gemini / Groq / NLLB).",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:7860/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Manga Translator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Turn translation on or off for this tab"
    },
    "toggle-original": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "Switch between the original and the Hindi page"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "manga-translator-hindi@local",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}